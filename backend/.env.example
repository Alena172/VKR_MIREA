POSTGRES_DB=vkr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=15432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/vkr_db?connect_timeout=5
# Провайдеры: stub | openai_compatible | ollama
AI_PROVIDER=stub
# Пример OpenAI-совместимого URL: https://api.openai.com/v1
# Пример Ollama с хоста для Docker-backend: http://host.docker.internal:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Пример OpenAI-совместимой модели: gpt-4o-mini
# Пример модели Ollama: llama3.1:8b
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
TRANSLATION_STRICT_REMOTE=true
JWT_SECRET=change_me_dev_secret_please_replace_32b
JWT_ISSUER=vkr
JWT_ACCESS_TTL_MINUTES=1440
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_ORIGIN_REGEX=^(chrome-extension://[a-p]{32}|moz-extension://.+)$
TRUSTED_HOSTS=localhost,127.0.0.1,backend,gateway
# Redis / Celery: локально обычно `localhost`, в Docker — `redis://redis:6379/0`
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT_SECONDS=10
LIBRETRANSLATE_ENABLED=true
BOOTSTRAP_SCHEMA_ON_STARTUP=true
SCRYPT_N=4096
